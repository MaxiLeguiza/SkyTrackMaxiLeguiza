datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum VuelosEstados {
  programado
  embarcado
  en_vuelo
  aterrizado
  cancelado
}

enum AvionEstado {
  disponible
  en_vuelo
  en_mantenimiento
}

enum UserRole {
  admin
  operador
}

model vuelos {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  numeroVuelo   String? 
  origen        String
  destino       String
  fechaSalida   String?
  horaSalida    String?
  fechaLlegada  String?
  horaLlegada   String?
  estado        VuelosEstados
  deleted       Boolean  @default(false)

  avionId       String?  @db.ObjectId
  avion         aviones? @relation(fields: [avionId], references: [id])
  
  tripulacionAsignada vuelosTripulantes[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model aviones {
id String @id @default(auto()) @map("_id") @db.ObjectId
modelo String
matricula String
capacidad Int
fabricante String
estado AvionEstado @default(disponible)
deleted Boolean @default(false)

vuelos vuelos[]

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model tripulantes {
id String @id @default(auto()) @map("_id") @db.ObjectId
nombre String
apellido String
rol String
licencia String
disponible Boolean @default(true)
deleted Boolean @default(false)

vuelosAsignados vuelosTripulantes[]

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model vuelosTripulantes {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  vueloId       String       @db.ObjectId
  vuelo         vuelos       @relation(fields: [vueloId], references: [id])
  
  tripulanteId  String       @db.ObjectId
  tripulante    tripulantes  @relation(fields: [tripulanteId], references: [id])
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  nombreusuario  String   @unique
  password       String
  role           UserRole
  createdAt      DateTime @default(now())
}
